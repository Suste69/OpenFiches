---
/**
 * Open Fiches logo — three overlapping casino chips and the wordmark.
 * The artwork lives in /public so the same SVG can also be embedded in
 * the README and reused outside the Astro component tree.
 *
 * `size` controls the rendered logo height; width remains proportional.
 */
interface Props {
  size?: number;
}

const { size = 80 } = Astro.props;
---

<img
  src="/open-fiches-logo.svg"
  height={size}
  width={size * 3}
  alt="Open Fiches"
  decoding="async"
/>
