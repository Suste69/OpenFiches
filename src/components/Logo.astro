---
/**
 * Open Fiches icon — three overlapping casino chips.
 * The wordmark is rendered as normal page text so it stays crisp and can
 * adapt to each layout. This SVG is reusable in the README and elsewhere.
 *
 * `size` controls both rendered width and height.
 */
interface Props {
  size?: number;
}

const { size = 80 } = Astro.props;
---

<img
  src="/open-fiches-logo.svg"
  height={size}
  width={size}
  alt="Open Fiches"
  decoding="async"
/>
