---
/**
 * Logo.astro — the Open Fiches mark: a cracked casino chip.
 * Built as inline SVG so it needs no external images and scales perfectly
 * at any size. The crack runs diagonally, with debris fragments flying out.
 *
 * Props:
 *   size — rendered width/height in pixels (viewBox is 200×200)
 */
interface Props {
  size?: number;
}

const { size = 190 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 200 200"
  fill="none"
  role="img"
  aria-label="Open Fiches logo — a cracked casino chip"
>

  <!-- ── Outer ring left half ────────────────────────────────────── -->
  <path
    d="M100 18 A82 82 0 0 0 18 100 A82 82 0 0 0 100 182"
    stroke="#2dd4bf" stroke-width="20" fill="none" stroke-linecap="butt"
  />
  <!-- ── Outer ring right half ───────────────────────────────────── -->
  <path
    d="M100 18 A82 82 0 0 1 182 100 A82 82 0 0 1 100 182"
    stroke="#5eead4" stroke-width="20" fill="none" stroke-linecap="butt"
  />

  <!-- ── Notch squares on the rim (8 squares evenly spaced) ─────── -->
  <g fill="#0d1017">
    <!-- top -->
    <rect x="88"  y="10"  width="24" height="14" rx="3"/>
    <!-- top-right -->
    <rect x="148" y="30"  width="14" height="24" rx="3" transform="rotate(45 155 42)"/>
    <!-- right -->
    <rect x="176" y="88"  width="14" height="24" rx="3"/>
    <!-- bottom-right -->
    <rect x="148" y="146" width="14" height="24" rx="3" transform="rotate(-45 155 158)"/>
    <!-- bottom -->
    <rect x="88"  y="176" width="24" height="14" rx="3"/>
    <!-- bottom-left -->
    <rect x="38"  y="146" width="14" height="24" rx="3" transform="rotate(45 45 158)"/>
    <!-- left -->
    <rect x="10"  y="88"  width="14" height="24" rx="3"/>
    <!-- top-left -->
    <rect x="38"  y="30"  width="14" height="24" rx="3" transform="rotate(-45 45 42)"/>
  </g>

  <!-- ── Inner circle ────────────────────────────────────────────── -->
  <circle cx="100" cy="100" r="50" fill="#151a24" stroke="#2dd4bf" stroke-width="3"/>

  <!-- ── Crack: jagged diagonal line splitting the chip ─────────── -->
  <!-- White base for contrast, drawn first -->
  <polyline
    points="108,14 96,52 115,72 88,100 112,128 94,148 102,186"
    stroke="#0d1017" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"
    fill="none"
  />
  <!-- Teal crack on top -->
  <polyline
    points="108,14 96,52 115,72 88,100 112,128 94,148 102,186"
    stroke="#f87171" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"
    fill="none"
  />

  <!-- ── Flying debris fragments ─────────────────────────────────── -->
  <!-- top-right cluster -->
  <polygon points="122,8  128,15  118,16" fill="#fbbf24"/>
  <polygon points="134,18 139,10  143,20" fill="#fbbf24" opacity="0.7"/>
  <rect x="126" y="22" width="5" height="5" rx="1" fill="#fbbf24" opacity="0.5"
        transform="rotate(20 128 24)"/>
  <!-- bottom-left cluster -->
  <polygon points="78,184  72,192  68,183" fill="#fbbf24"/>
  <polygon points="62,174  56,182  65,184" fill="#fbbf24" opacity="0.7"/>
  <rect x="69" y="176" width="5" height="5" rx="1" fill="#fbbf24" opacity="0.5"
        transform="rotate(-15 71 178)"/>

</svg>
